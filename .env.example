DB_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infoman_project
DB_USER=infoman_app
DB_PASSWORD=change-me
DB_SSL=disable

# Reset is localhost-only unless you explicitly add development hosts here.
# Reset credentials need CREATEDB and permission to assign DB_USER as owner.
DB_RESET_ALLOWED_HOSTS=
DB_RESET_USER=
DB_RESET_PASSWORD=
