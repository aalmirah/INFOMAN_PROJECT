NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

DB_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infoman_project
DB_USER=infoman_app
DB_PASSWORD=change-me
DB_SSL=disable

# Reset credentials are only for the destructive local development reset command.
# Leave the host allowlist blank for localhost-only resets.
DB_RESET_ALLOWED_HOSTS=
DB_RESET_USER=
DB_RESET_PASSWORD=
